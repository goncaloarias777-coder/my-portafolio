<section id="contacto" class="max-w-6xl mx-auto px-6 py-24 border-t border-zinc-900">
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
    <div>
      <h2 class="text-xs font-bold tracking-widest text-cyan-400 uppercase mb-3">Hablemos de negocios</h2>
      <p class="text-4xl sm:text-5xl font-extrabold tracking-tight mb-6">¿Tenés un proyecto en mente?</p>
      <p class="text-zinc-400 leading-relaxed mb-8">
        Ya sea que necesites renovar la identidad digital de tu empresa, crear un nuevo producto desde cero o potenciar tu velocidad web, estoy listo para colaborar con vos.
      </p>
      <div class="flex items-center gap-4 text-sm text-zinc-300 font-medium">
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-400"></span>
        Respuesta estimada en menos de 24 horas hábiles.
      </div>
    </div>

    <div class="bg-zinc-900/50 border border-zinc-800/80 p-8 rounded-3xl shadow-2xl">
      <form id="form-contacto" class="space-y-6">
        <div>
          <label class="block text-xs font-semibold text-zinc-300 uppercase tracking-wider mb-2">Tu Nombre</label>
          <input type="text" id="nombre" name="nombre" required class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-4 py-3 text-white text-sm focus:outline-none focus:border-cyan-500 transition-colors" placeholder="Ej. Juan Pérez" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-zinc-300 uppercase tracking-wider mb-2">Tu Correo Electrónico</label>
          <input type="email" id="email" name="email" required class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-4 py-3 text-white text-sm focus:outline-none focus:border-cyan-500 transition-colors" placeholder="juan@empresa.com" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-zinc-300 uppercase tracking-wider mb-2">Detalles del Proyecto</label>
          <textarea id="mensaje" name="mensaje" rows="4" required class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-4 py-3 text-white text-sm focus:outline-none focus:border-cyan-500 transition-colors resize-none" placeholder="Contame brevemente qué necesitás resolver..."></textarea>
        </div>
        <button type="submit" id="btn-enviar" class="w-full bg-gradient-to-r from-cyan-500 to-teal-400 text-zinc-950 font-bold py-4 rounded-xl hover:opacity-90 transition-opacity shadow-lg shadow-cyan-500/20 text-sm cursor-pointer">
          Enviar Mensaje a Gonzalo
        </button>
        <p id="form-status" class="text-xs text-center font-medium mt-2 hidden"></p>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('form-contacto') as HTMLFormElement;
  const btnEnviar = document.getElementById('btn-enviar') as HTMLButtonElement;
  const formStatus = document.getElementById('form-status') as HTMLParagraphElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const nombre = (document.getElementById('nombre') as HTMLInputElement).value;
    const email = (document.getElementById('email') as HTMLInputElement).value;
    const mensaje = (document.getElementById('textarea') as HTMLTextAreaElement)?.value || (document.getElementById('mensaje') as HTMLTextAreaElement).value;

    btnEnviar.textContent = "Enviando mensaje...";
    btnEnviar.setAttribute('disabled', 'true');

    try {
      const res = await fetch('/api/contacto', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ nombre, email, mensaje })
      });

      const data = await res.json();

      if (res.ok) {
        formStatus.textContent = "¡Mensaje enviado con éxito! Me pondré en contacto pronto.";
        formStatus.className = "text-xs text-center font-medium mt-2 text-emerald-400";
        formStatus.classList.remove('hidden');
        form.reset();
      } else {
        throw new Error(data.error || "Ocurrió un error");
      }
    } catch (error) {
      formStatus.textContent = "Hubo un error al enviar. Por favor,intentá de nuevo.";
      formStatus.className = "text-xs text-center font-medium mt-2 text-rose-400";
      formStatus.classList.remove('hidden');
    } finally {
      btnEnviar.textContent = "Enviar Mensaje a Gonzalo";
      btnEnviar.removeAttribute('disabled');
    }
  });
</script>