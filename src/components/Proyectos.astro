 ---
// Puedes definir tus proyectos en un array aquí arriba para que sea más fácil agregar o editar después
const projects = [
  {
    title: "Barber Demo",
    tag: "Barber",
    description: "Landing page moderna para barberías y servicios estéticos con secciones de turnos y estilos.",
    link: "https://barber-demo-lime-eta.vercel.app/",
    techs: ["Astro", "Tailwind", "Vercel"]
  },
  {
    title: "Nail Lab",
    tag: "NailLab",
    description: "Sitio web minimalista para estudios de manicura, enfocado en mostrar trabajos y contacto directo.",
    link: "https://nail-lab-xi.vercel.app/",
    techs: ["Astro", "Tailwind", "Vercel"]
  },
  {
    title: "Motorfix",
    tag: "Motorfix",
    description: "Landing orientada a talleres mecánicos y servicios automotrices, con llamado a la acción rápido.",
    link: "https://motorfix-wheat.vercel.app/",
    techs: ["Astro", "Tailwind", "Vercel"]
  }
];
---

<section class="max-w-4xl mx-auto px-6 py-10 space-y-8">
  
  <!-- Título de Sección -->
  <div class="space-y-2">
    <span class="text-xs uppercase tracking-widest text-cyan-400 font-semibold">Desarrollo Web</span>
    <h2 class="text-2xl font-bold tracking-tight text-zinc-100">Mis Landing Pages</h2>
    <p class="text-sm text-zinc-400">Proyectos recientes optimizados para conversión y rendimiento en Vercel.</p>
  </div>

  <!-- Grilla de Tarjetas -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
    {projects.map((project) => (
      <a 
        href={project.link} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="group relative bg-zinc-900/80 border border-zinc-800 rounded-2xl p-5 flex flex-col justify-between hover:border-cyan-500/50 hover:bg-zinc-900 transition-all duration-300 shadow-xl"
      >
        <div class="space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-xs font-mono text-cyan-400 bg-cyan-950/60 border border-cyan-800/40 px-2.5 py-1 rounded-md">
              {project.tag}
            </span>
            <svg class="w-4 h-4 text-zinc-500 group-hover:text-cyan-400 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
            </svg>
          </div>
          <div>
            <h3 class="font-bold text-base text-zinc-100 group-hover:text-cyan-400 transition-colors">
              {project.title}
            </h3>
            <p class="text-xs text-zinc-400 mt-1 leading-relaxed">
              {project.description}
            </p>
          </div>
        </div>

        <!-- Tecnologías -->
        <div class="flex flex-wrap gap-1.5 pt-4 mt-4 border-t border-zinc-800/60">
          {project.techs.map((tech) => (
            <span class="text-[10px] bg-zinc-800/80 text-zinc-300 px-2 py-0.5 rounded-md">
              {tech}
            </span>
          ))}
        </div>
      </a>
    ))}
  </div>
</section>
