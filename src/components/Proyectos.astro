---
const proyectos = [
  {
    titulo: "Inmobiliaria PropiedadesYa",
    descripcion: "Plataforma web autoadministrable para gestión de inmuebles, filtros avanzados y contacto rápido.",
    tags: ["Astro", "React", "Tailwind", "Sanity CMS"],
    // Imagen: Puedes poner la ruta de tu imagen acá, ej: "/images/proyecto-inmo.jpg"
    // Si está vacía, usaremos un fondo de diseño.
    imagen: "", 
    link: "#"
  },
  {
    titulo: "SaaS Gestión Médica Pro",
    descripcion: "Dashboard privado para clínicas, turnos online, historiales clínicos y reportes en tiempo real.",
    tags: ["Next.js", "TypeScript", "Prisma", "PostgreSQL"],
    imagen: "", // Dejamos vacío intencionalmente
    link: "#"
  },
  {
    titulo: "E-commerce Local Shop",
    descripcion: "Tienda online minimalista con pasarela de pago integrada y panel de control de inventario.",
    tags: ["Astro", "Alpine.js", "Snipcart", "CSS Grid"],
    imagen: "", // Dejamos vacío intencionalmente
    link: "#"
  }
];

// Colores de acento aleatorios para los fondos decorativos
const coloresFondo = [
  "from-cyan-900/80 via-zinc-900 to-zinc-950",
  "from-sky-900/80 via-zinc-900 to-zinc-950",
  "from-teal-900/80 via-zinc-900 to-zinc-950",
];
---

<section id="proyectos" class="max-w-6xl mx-auto px-6 py-24">
  <div class="mb-16 max-w-2xl">
    <h2 class="text-xs font-bold tracking-widest text-cyan-400 uppercase mb-3">Portafolio</h2>
    <p class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-4">Proyectos Destacados</p>
    <p class="text-zinc-400 text-lg">Una selección de trabajos recientes enfocados en rendimiento, diseño UI/UX y resultados.</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
    {proyectos.map((proyecto, index) => (
      <div class="group bg-zinc-900/40 border border-zinc-800 rounded-3xl p-6 flex flex-col transition-all duration-300 hover:border-cyan-500/30 hover:-translate-y-2 hover:shadow-2xl hover:shadow-cyan-500/5 relative overflow-hidden">
        
        {/* CONTENEDOR VISUAL SUPERIOR (Imagen o Fondo Decorativo) */}
        <div class="aspect-video w-full rounded-2xl mb-6 overflow-hidden relative border border-zinc-700/50 mb-auto">
          {proyecto.imagen ? (
            // Si hay imagen, se muestra
            <img 
              src={proyecto.imagen} 
              alt={`Captura de pantalla de ${proyecto.titulo}`} 
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
          ) : (
            // SINO HAY IMAGEN: Fondo decorativo profesional (Glassmorphism + Gradiente)
            <div class={`absolute inset-0 bg-gradient-to-br ${coloresFondo[index % coloresFondo.length]} flex items-center justify-center relative`}>
              
              {/* Efectos de luz de fondo sutiles */}
              <div class="absolute -top-10 -left-10 w-32 h-32 bg-cyan-500/10 rounded-full blur-2xl"></div>
              <div class="absolute -bottom-10 -right-10 w-32 h-32 bg-teal-500/10 rounded-full blur-2xl"></div>
              
              {/* Iniciales o ícono sutil */}
              <span class="text-6xl font-black text-zinc-700/50 select-none font-mono tracking-tighter">
                {proyecto.titulo.split(' ').map(n=>n[0]).join('').substring(0,2)}
              </span>

               {/* Overlay sutil de ruido o patrón */}
              <div class="absolute inset-0 opacity-[0.02]" style="background-image: url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAQAAAAEABAMAAABDrC+iAAAAIFBMVEUAAAD///////////////////////////////////93jGkqAAAACXBIWXMAAA7EAAAOxAGVKw4bAAAAHklEQVRoge3BAQEAAACCIP+vbkhAAQAAAAAAAAAAAPA1oAgjCWhCBB8AAAAASUVORK5CYII=');"></div>
            </div>
          )}
          
          {/* Overlay oscuro al hacer hover */}
          <div class="absolute inset-0 bg-black/20 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
             <span class="bg-white/10 text-white backdrop-blur-sm px-4 py-2 rounded-full text-sm font-medium border border-white/20">Ver detalles →</span>
          </div>
        </div>

        {/* CONTENIDO DE TEXTO */}
        <div class="mt-6">
          <h3 class="text-xl font-bold text-white mb-3 group-hover:text-cyan-300 transition-colors">{proyecto.titulo}</h3>
          <p class="text-zinc-400 text-sm mb-5 leading-relaxed line-clamp-3">{proyecto.descripcion}</p>
          
          <div class="flex flex-wrap gap-2 pt-4 border-t border-zinc-800">
            {proyecto.tags.map((tag) => (
              <span class="bg-zinc-800 text-zinc-300 px-3 py-1 rounded-full text-xs font-medium">
                {tag}
              </span>
            ))}
          </div>
        </div>

        {/* Enlace completo (cubre toda la tarjeta) */}
        <a href={proyecto.link} class="absolute inset-0 z-10" aria-label={`Ver más sobre ${proyecto.titulo}`}></a>
      </div>
    ))}
  </div>
</section>