 ---
const projects = [
  {
    title: "Barber Demo",
    tag: "Barber",
    description: "Landing page moderna para barberías y servicios estéticos.",
    link: "https://barber-demo-lime-eta.vercel.app/",
    techs: ["Astro", "Tailwind", "Vercel"]
  },
  {
    title: "Nail Lab",
    tag: "NailLab",
    description: "Sitio web minimalista para estudios de manicura.",
    link: "https://nail-lab-xi.vercel.app/",
    techs: ["Astro", "Tailwind", "Vercel"]
  },
  {
    title: "Motorfix",
    tag: "Motorfix",
    description: "Landing orientada a talleres mecánicos y servicios automotrices.",
    link: "https://motorfix-wheat.vercel.app/",
    techs: ["Astro", "Tailwind", "Vercel"]
  }
];
---

<section class="max-w-6xl mx-auto px-6 py-10 space-y-8">
  <div class="space-y-2">
    <span class="text-xs uppercase tracking-widest text-cyan-400 font-semibold">Portafolio</span>
    <h2 class="text-3xl font-bold tracking-tight text-zinc-100">Mis Landings</h2>
    <p class="text-sm text-zinc-400">Proyectos recientes desplegados en Vercel.</p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
    {projects.map((project) => (
      <a 
        href={project.link} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="group relative bg-zinc-900/90 border border-zinc-800 rounded-2xl p-6 flex flex-col justify-between hover:border-cyan-500/50 hover:bg-zinc-900 transition-all duration-300 shadow-xl hover:-translate-y-1"
      >
        <div class="space-y-4">
          <div class="flex items-center justify-between">
            <span class="text-xs font-mono text-cyan-400 bg-cyan-950/60 border border-cyan-800/40 px-3 py-1 rounded-full">
              {project.tag}
            </span>
            <svg class="w-5 h-5 text-zinc-500 group-hover:text-cyan-400 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
            </svg>
          </div>

          <div class="space-y-2">
            <h3 class="font-bold text-xl text-zinc-100 group-hover:text-cyan-400 transition-colors">
              {project.title}
            </h3>
            <p class="text-sm text-zinc-400 leading-relaxed">
              {project.description}
            </p>
          </div>
        </div>

        <div class="flex flex-wrap gap-1.5 pt-6 mt-6 border-t border-zinc-800/80">
          {project.techs.map((tech) => (
            <span class="text-[11px] bg-zinc-800 text-zinc-300 px-2.5 py-1 rounded-md">
              {tech}
            </span>
          ))}
        </div>
      </a>
    ))}
  </div>
</section>
