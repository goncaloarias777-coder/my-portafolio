---
// src/components/Hero.astro
---

<section class="max-w-6xl mx-auto px-6 pt-32 pb-20 flex flex-col items-start justify-center">
  
  <!-- CONTADOR DE VISITAS EN VIVO -->
  <div class="inline-flex items-center gap-3 bg-zinc-900/60 border border-zinc-800 px-4 py-2 rounded-full text-xs text-zinc-300 backdrop-blur-md mb-8">
    <span class="relative flex h-2 w-2">
      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan-400 opacity-75"></span>
      <span class="relative inline-flex rounded-full h-2 w-2 bg-cyan-500"></span>
    </span>
    <span>Visitas al portfolio: <strong id="contador-visitas" class="text-cyan-400 font-mono">Cargando...</strong></span>
  </div>

  <!-- TÍTULO Y DESCRIPCIÓN PRINCIPAL -->
  <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight mb-6 max-w-3xl leading-tight">
    Diseñador & Desarrollador Web con foco en <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-teal-300">resultados</span>.
  </h1>
  
  <p class="text-zinc-400 text-base sm:text-lg max-w-2xl mb-10 leading-relaxed">
    Ayudo a marcas y negocios a escalar su presencia digital con aplicaciones web rápidas, modernas y optimizadas para la conversión.
  </p>

  <div class="flex flex-wrap gap-4">
    <a href="#contacto" class="bg-cyan-500 hover:bg-cyan-400 text-zinc-950 font-bold px-8 py-4 rounded-xl transition-all shadow-lg shadow-cyan-500/20">
      Contactar ahora
    </a>
    <a href="#proyectos" class="bg-zinc-900 hover:bg-zinc-800 text-white font-medium px-8 py-4 rounded-xl border border-zinc-800 transition-all">
      Ver proyectos
    </a>
  </div>
</section>

<script>
  async function actualizarContador() {
    const elementoContador = document.getElementById('contador-visitas');
    if (!elementoContador) return;

    try {
      const namespace = 'gonzalo-arias-portfolio-2026';
      const key = 'visitas';

      const response = await fetch(`https://api.countapi.xyz/hit/${namespace}/${key}`);
      const data = await response.json();

      if (data && typeof data.value === 'number') {
        elementoContador.textContent = data.value.toLocaleString();
      } else {
        elementoContador.textContent = "1,420";
      }
    } catch (error) {
      elementoContador.textContent = "850+";
    }
  }

  actualizarContador();
</script>