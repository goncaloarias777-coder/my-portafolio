---
const skills = [
  { nombre: "Astro", categoria: "Framework Frontend", nivel: "Avanzado" },
  { nombre: "Tailwind CSS", categoria: "Estilos & UI", nivel: "Expert" },
  { nombre: "React / Next.js", categoria: "Ecosistema JS", nivel: "Avanzado" },
  { nombre: "TypeScript", categoria: "Tipado Estático", nivel: "Avanzado" },
  { nombre: "Figma", categoria: "Diseño UI/UX", nivel: "Avanzado" },
  { nombre: "Git & GitHub", categoria: "Control de Versiones", nivel: "Avanzado" },
];
---

<section id="skills" class="max-w-6xl mx-auto px-6 py-20 border-t border-zinc-900">
  <div class="mb-16">
    <h2 class="text-xs font-bold tracking-widest text-cyan-400 uppercase mb-3">Stack & Herramientas</h2>
    <p class="text-3xl sm:text-4xl font-extrabold tracking-tight">Tecnologías que domino</p>
  </div>

  <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-4">
    {skills.map((skill) => (
      <div class="group bg-zinc-900/40 border border-zinc-800/80 p-5 rounded-2xl flex flex-col items-center justify-center text-center hover:border-cyan-500/50 hover:bg-zinc-900 transition-all duration-300">
        <span class="text-white font-bold text-sm mb-1 group-hover:text-cyan-400 transition-colors">
          {skill.nombre}
        </span>
        <span class="text-[11px] text-zinc-500 font-medium">
          {skill.categoria}
        </span>
      </div>
    ))}
  </div>
</section>