---
const metricas = [
  {
    cifra: "+98%",
    titulo: "Satisfacción de Clientes",
    descripcion: "Proyectos entregados cumpliendo objetivos y plazos acordados.",
  },
  {
    cifra: "< 1s",
    titulo: "Velocidad de Carga",
    descripcion: "Optimización extrema para puntajes máximos en rendimiento web.",
  },
  {
    cifra: "+15",
    titulo: "Proyectos Exitosos",
    descripcion: "Aplicaciones web, e-commerce y landing pages escaladas a producción.",
  },
  {
    cifra: "100%",
    titulo: "Enfoque en Conversión",
    descripcion: "Diseños pensados estratégicamente para transformar visitantes en clientes.",
  },
];
---

<section class="max-w-6xl mx-auto px-6 py-16 border-t border-zinc-900">
  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6">
    {metricas.map((item) => (
      <div class="bg-zinc-900/40 border border-zinc-800/80 p-6 rounded-2xl flex flex-col justify-between hover:border-cyan-500/40 transition-all">
        <div>
          <!-- Cifra principal grande con degradado -->
          <span class="text-4xl sm:text-5xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-teal-300 font-mono tracking-tight mb-3 block">
            {item.cifra}
          </span>
          <h3 class="text-white font-bold text-base mb-1">
            {item.titulo}
          </h3>
          <p class="text-zinc-400 text-xs leading-relaxed">
            {item.descripcion}
          </p>
        </div>
      </div>
    ))}
  </div>
</section>