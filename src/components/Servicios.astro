---
const servicios = [
  {
    numero: "01",
    titulo: "Diseño UI/UX & Prototipado",
    descripcion: "Interfaces modernas creadas en Figma con enfoque en la experiencia de usuario, diseño de sistemas (design systems) y retinas ópticas.",
  },
  {
    numero: "02",
    titulo: "Desarrollo Web Full-Stack",
    descripcion: "Sitios corporativos, landing pages de alta conversión y aplicaciones web robustas desarrolladas con tecnologías de última generación.",
  },
  {
    numero: "03",
    titulo: "Optimización de Rendimiento & SEO",
    descripcion: "Mejora radical de velocidad de carga, optimización para motores de búsqueda (Lighthouse 100/100) y accesibilidad web.",
  },
];
---
<section id="servicios" class="max-w-6xl mx-auto px-6 py-20 border-t border-zinc-900">
  <div class="mb-16">
    <h2 class="text-xs font-bold tracking-widest text-cyan-400 uppercase mb-3">Qué ofrezco</h2>
    <p class="text-3xl sm:text-4xl font-extrabold tracking-tight">Soluciones a tu medida</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    {servicios.map((servicio) => (
      <div class="bg-zinc-900/30 border border-zinc-800/80 rounded-2xl p-8 flex flex-col justify-between hover:border-cyan-500/40 transition-all">
        <div>
          <span class="text-3xl font-extrabold text-cyan-500/40 mb-6 block">{servicio.numero}</span>
          <h3 class="text-xl font-bold text-white mb-4">{servicio.titulo}</h3>
          <p class="text-zinc-400 text-sm leading-relaxed">{servicio.descripcion}</p>
        </div>
      </div>
    ))}
  </div>
</section>